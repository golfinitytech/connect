PORT=3002

# --- Database: Supabase (PostgreSQL) ---
# Supabase dashboard -> Project -> Connect. URL-encode special chars in the password (@ -> %40).
# Runtime: session pooler (port 5432). The API is a long-running server, so session mode is
# the right fit; the transaction pooler (6543) measured ~2s per query here and broke transactions.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?connection_limit=5"
# Migrations: same session connection (port 5432)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Local Postgres instead (docker compose up -d):
# DATABASE_URL="postgresql://golfinity:golfinity@localhost:5432/golfinity_connect"
# DIRECT_URL="postgresql://golfinity:golfinity@localhost:5432/golfinity_connect"

# --- Supabase Storage (face photos) ---
# Supabase dashboard -> Project Settings -> API. Service-role key is server-only, never ship it to clients.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FACE_BUCKET=face-photos

JWT_SECRET="ganti-dengan-string-acak-yang-panjang"

# Fallback marshal PIN (4 digits) if a tournament has none set
MARSHAL_PIN=

# Optional
ADMIN_DASHBOARD_TOKEN=
FRONTEND_URL=http://localhost:5173
MAILERSEND_API_KEY=
MAIL_FROM=
MAIL_NAME=Golfinity Connect
FIREBASE_CONFIG_PATH=
