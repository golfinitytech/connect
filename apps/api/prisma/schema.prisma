generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" = Vercel serverless runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: session pooler (port 5432) used by the app at runtime
  url       = env("DATABASE_URL")
  // Supabase: session pooler (port 5432) used by migrations
  directUrl = env("DIRECT_URL")
}

enum RoundStatus {
  DRAFT
  IN_PROGRESS
  FINISHED
}

enum GameMode {
  STROKE_PLAY
  STABLEFORD
  MATCH_PLAY
}

enum FairwayHit {
  LEFT
  CENTER
  RIGHT
}

enum OrderStatus {
  PENDING
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum NotificationCategory {
  TOURNAMENT
  ORDER
  SOCIAL
  SYSTEM
}

enum PrivacyMode {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  fullName           String
  password           String?
  memberId           String              @unique
  avatarUrl          String?
  fcmToken           String?
  handicapIndex      Decimal             @db.Decimal(4, 1)
  emailVerified      DateTime?
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  lastSeenLat        Float?
  lastSeenLng        Float?
  facePhotoPath      String?
  facePhotoUpdatedAt DateTime?
  verificationToken  String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roundPlayers       RoundPlayer[]
  holeScores         HoleScore[]
  orders             Order[]
  eventRegistrations EventRegistration[]
  notifications      Notification[]
  preference         UserPreference?
  passwordResets     PasswordReset[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model Course {
  id         String   @id @default(cuid())
  name       String
  city       String
  country    String
  imageUrl   String?
  totalHoles Int      @default(18)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  holes      Hole[]
  teeBoxes   TeeBox[]
  rounds     Round[]
  events     Event[]
}

model Hole {
  id        String      @id @default(cuid())
  courseId  String
  number    Int
  par       Int
  lengthYds Int
  latitude  Float?
  longitude Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scores    HoleScore[]

  @@unique([courseId, number])
}

model TeeBox {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  yardage   Int
  rating    Decimal  @db.Decimal(4, 1)
  slope     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rounds    Round[]
}

model Round {
  id          String        @id @default(cuid())
  courseId    String
  teeBoxId    String
  gameMode    GameMode
  status      RoundStatus   @default(DRAFT)
  startedAt   DateTime?
  finishedAt  DateTime?
  currentHole Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course        @relation(fields: [courseId], references: [id])
  teeBox      TeeBox        @relation(fields: [teeBoxId], references: [id])
  players     RoundPlayer[]
  holeScores  HoleScore[]
}

model RoundPlayer {
  id        String   @id @default(cuid())
  roundId   String
  userId    String
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
}

model HoleScore {
  id         String      @id @default(cuid())
  roundId    String
  holeId     String
  userId     String
  strokes    Int
  putts      Int
  fairwayHit FairwayHit?
  gir        Boolean?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  round      Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  hole       Hole        @relation(fields: [holeId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, holeId, userId])
}

model Event {
  id            String              @id @default(cuid())
  title         String
  subtitle      String?
  imageUrl      String?
  startDate     DateTime
  courseId      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course              @relation(fields: [courseId], references: [id])
  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  category  NotificationCategory
  createdAt DateTime             @default(now())
  readAt    DateTime?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserPreference {
  id                   String      @id @default(cuid())
  userId               String      @unique
  notificationsEnabled Boolean     @default(true)
  marketingEmails      Boolean     @default(false)
  privacyMode          PrivacyMode @default(MEMBERS_ONLY)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  name        String
  description String
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

model Order {
  id         String           @id @default(cuid())
  userId     String
  roundId    String?
  locationId String? // e.g. karawang, sulaiman, jatinangor
  caddieCode String? // e.g. 139
  holeNumber Int?
  status     OrderStatus      @default(PENDING)
  subtotal   Decimal          @db.Decimal(10, 2)
  serviceFee Decimal          @db.Decimal(10, 2)
  totalPaid  Decimal          @db.Decimal(10, 2)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  statusLogs OrderStatusLog[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Tournament {
  id            String               @id @default(cuid())
  name          String
  date          DateTime
  course        String
  teeBox        String
  teeTime       String
  rules         String
  scoringMethod String
  /// Short numeric access code typed on tablets (3 digits, e.g. "482").
  code          String?
  /// Par per hole, index 0 = hole 1 (18 ints). Null = default par layout.
  pars          Json?
  /// PIN the marshal must enter to edit a validated score. Checked server-side only.
  marshalPin    String?
  publishedAt   DateTime?
  finishedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  players       TournamentPlayer[]
  groups        TournamentGroup[]
  scores        TournamentScore[]
  scoreLogs     TournamentScoreLog[]
  messages      TournamentMessage[]

  @@index([code])
}

model TournamentPlayer {
  id           String            @id @default(cuid())
  tournamentId String
  code         String?
  name         String
  dob          String?
  shirtSize    String?
  phone        String?
  email        String?
  handicap     Int
  flight       String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId      String?
  group        TournamentGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  scores       TournamentScore[]

  @@unique([tournamentId, code])
  @@index([code])
}

model TournamentGroup {
  id           String             @id @default(cuid())
  tournamentId String
  /// Flight access code typed on tablets. New tournaments use the flight number ("1", "2", ...).
  code         String
  /// Flight number within the tournament (1..99).
  number       Int?
  /// Shotgun start hole for this flight (1..18).
  startHole    Int?
  flightType   String
  caddieData   Json?
  scoresData   Json?
  createdAt    DateTime           @default(now())
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players      TournamentPlayer[]

  @@unique([tournamentId, code])
  @@index([code])
}

model AdminNotification {
  id                String   @id @default(cuid())
  roleInfo          String
  changedHole       Int
  changedPlayerName String
  newScore          Int
  isApproved        Boolean  @default(false)
  isMarshalEdit     Boolean  @default(false)
  groupCode         String?
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CaddiePerformance {
  id         String   @id @default(cuid())
  locationId String
  caddieCode String
  playerName String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum TournamentScoreStatus {
  ENTERED
  VALIDATED
}

/// One row per player per hole. Single source of truth for tournament scores.
model TournamentScore {
  id              String                @id @default(cuid())
  tournamentId    String
  playerId        String
  hole            Int
  /// Gross strokes. Null when the player is marked OUT on this hole.
  strokes         Int?
  isOut           Boolean               @default(false)
  status          TournamentScoreStatus @default(ENTERED)
  editedByMarshal Boolean               @default(false)
  /// Incremented on every change; used for optimistic concurrency between devices.
  version         Int                   @default(1)
  enteredBy       String?
  validatedBy     String?
  validatedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tournament      Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player          TournamentPlayer      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, hole])
  @@index([tournamentId])
}

/// Append-only audit trail of every score change.
model TournamentScoreLog {
  id           String     @id @default(cuid())
  tournamentId String
  playerId     String
  playerName   String
  hole         Int
  /// ENTER | CLEAR | VALIDATE | MARSHAL_EDIT
  action       String
  oldStrokes   Int?
  newStrokes   Int?
  oldIsOut     Boolean?
  newIsOut     Boolean?
  actorRole    String
  actorName    String?
  groupCode    String?
  reason       String?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
}

model TournamentMessage {
  id           String     @id @default(cuid())
  tournamentId String
  /// control | all | marshal
  toTarget     String
  /// caddie | admin | marshal
  fromRole     String
  fromName     String
  groupCode    String?
  text         String     @db.Text
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Portal Akademik (academy) — used by apps/admin-dashboard /portalakademik
// ─────────────────────────────────────────────────────────────

enum AcademyRole {
  STUDENT
  COACH
  ADMIN
}

enum AcademyAccountStatus {
  ACTIVE
  INACTIVE
}

enum AcademyProgressStatus {
  LOCKED
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum AcademySessionStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum AcademyEvaluationStatus {
  PENDING
  COMPLETED
}

enum AcademyContentType {
  BOOKLET
  VIDEO
  ARTICLE
  COACH_TIP
}

model AcademyAccount {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  name              String
  role              AcademyRole
  status            AcademyAccountStatus @default(ACTIVE)
  avatarUrl         String?
  phone             String?
  // Coach-only
  specialty         String?
  rating            Decimal?             @db.Decimal(2, 1)
  // Student-only
  coachId           String?
  coach             AcademyAccount?      @relation("CoachStudents", fields: [coachId], references: [id], onDelete: SetNull)
  students          AcademyAccount[]     @relation("CoachStudents")
  programId         String?
  program           AcademyProgram?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  packageName       String?
  remainingSessions Int? // null = unlimited
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  sessionsAsStudent    AcademySession[]    @relation("SessionStudent")
  sessionsAsCoach      AcademySession[]    @relation("SessionCoach")
  evaluationsAsStudent AcademyEvaluation[] @relation("EvaluationStudent")
  evaluationsAsCoach   AcademyEvaluation[] @relation("EvaluationCoach")
  progress             AcademyProgress[]
  sentMessages         AcademyMessage[]    @relation("MessageSender")
  receivedMessages     AcademyMessage[]    @relation("MessageRecipient")
  feedback             AcademyFeedback[]

  @@index([role])
  @@index([coachId])
}

model AcademyVenue {
  id        String           @id @default(cuid())
  name      String           @unique
  location  String
  rating    Decimal?         @db.Decimal(2, 1)
  imageUrl  String?
  createdAt DateTime         @default(now())
  sessions  AcademySession[]
}

/// A level in the curriculum, e.g. "Level 1 - Beginner Program".
model AcademyProgram {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "level1"
  level       String // e.g. "Level 1"
  title       String
  description String?
  difficulty  String?
  rating      Decimal? @db.Decimal(2, 1)
  color       String   @default("emerald")
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules   AcademyModule[]
  sublevels AcademySublevel[]
  students  AcademyAccount[]
  sessions  AcademySession[]
}

/// Curriculum module shown on the admin Curriculum page.
model AcademyModule {
  id        String         @id @default(cuid())
  programId String
  program   AcademyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  duration  String
  status    String         @default("Active") // Active | Draft
  drills    String[]
  sortOrder Int            @default(0)
}

/// Syllabus block (e.g. "Level 1a") ending in an evaluation.
model AcademySublevel {
  id             String                  @id @default(cuid())
  programId      String
  program        AcademyProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  name           String
  evaluationName String
  sortOrder      Int                     @default(0)
  lessons        AcademySyllabusLesson[]
}

model AcademySyllabusLesson {
  id         String            @id @default(cuid())
  sublevelId String
  sublevel   AcademySublevel   @relation(fields: [sublevelId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int               @default(0)
  progress   AcademyProgress[]
}

/// Per-student status of a syllabus lesson. Missing row = derived (LOCKED/PENDING).
model AcademyProgress {
  id        String                @id @default(cuid())
  studentId String
  student   AcademyAccount        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    AcademySyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status    AcademyProgressStatus
  updatedAt DateTime              @updatedAt

  @@unique([studentId, lessonId])
}

/// A scheduled / booked training session between a coach and a student.
model AcademySession {
  id          String               @id @default(cuid())
  studentId   String
  student     AcademyAccount       @relation("SessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  coachId     String
  coach       AcademyAccount       @relation("SessionCoach", fields: [coachId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       AcademyVenue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  location    String? // free text when not a known venue (e.g. "Golfinity Hub - Indoor")
  programId   String?
  program     AcademyProgram?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  startsAt    DateTime
  endsAt      DateTime
  type        String // e.g. "On-Field Training", "Private"
  topic       String?
  status      AcademySessionStatus @default(UPCOMING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  evaluations AcademyEvaluation[]

  @@index([coachId, startsAt])
  @@index([studentId, startsAt])
}

model AcademyEvaluation {
  id          String                  @id @default(cuid())
  studentId   String
  student     AcademyAccount          @relation("EvaluationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  coachId     String
  coach       AcademyAccount          @relation("EvaluationCoach", fields: [coachId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     AcademySession?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  topic       String
  levelLabel  String?
  status      AcademyEvaluationStatus @default(PENDING)
  score       Decimal?                @db.Decimal(5, 2) // 0-100
  notes       String?
  evaluatedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([coachId, status])
  @@index([studentId])
}

model AcademyLearningContent {
  id          String             @id @default(cuid())
  title       String
  type        AcademyContentType
  description String
  duration    String
  tag         String?
  url         String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
}

model AcademyMessage {
  id          String         @id @default(cuid())
  senderId    String
  sender      AcademyAccount @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   AcademyAccount @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text        String
  readAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model AcademyFeedback {
  id        String         @id @default(cuid())
  accountId String
  account   AcademyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  category  String
  message   String
  createdAt DateTime       @default(now())

  @@index([createdAt])
}
